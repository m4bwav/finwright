#!/bin/sh
# Leak gate: scan the staged files and the commit identity before every commit.
# Enable once per clone: git config core.hooksPath .githooks
# The deny-list lives outside this repository: git config finwright.denylist <path>, or $FINWRIGHT_LEAK_DENYLIST.
root=$(git rev-parse --show-toplevel) || exit 2
for p in python3 python py; do
  if command -v "$p" >/dev/null 2>&1 && "$p" -c "import sys; sys.exit(0 if sys.version_info >= (3, 8) else 1)" </dev/null >/dev/null 2>&1; then
    exec "$p" "$root/tools/leak_scan.py" staged "$root"
  fi
done
echo "pre-commit: no Python 3 found; the leak gate cannot run, so the commit is blocked" >&2
exit 2
